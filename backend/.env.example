# Copy this file to .env (never commit .env with real secrets)
# PowerShell: Copy-Item backend\.env.example backend\.env
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-change-me
JWT_EXPIRES_HOURS=24
DATABASE_URL=postgresql+psycopg2://taskflow:KrishMeet@taskflow-db.cxw0aygsspq6.eu-north-1.rds.amazonaws.com:5432/taskflow
# AWS/RDS example (Phase 9/10 — keep commented locally):
# DATABASE_URL=postgresql+psycopg2://taskflow:PASSWORD@your-rds-endpoint:5432/taskflow
CORS_ORIGINS=http://localhost:5173
FLASK_ENV=development
# Files: local | s3
STORAGE_BACKEND=local
UPLOAD_MAX_MB=5
ALLOWED_EXTENSIONS=pdf,txt,docx
LOCAL_UPLOAD_DIR=uploads
# S3 (Phase 9 — leave empty locally; EC2 uses an IAM role, no keys in code)
S3_BUCKET=
S3_REGION=
S3_PREFIX=study-files/
