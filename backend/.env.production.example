# Production env template for EC2 (copy to backend/.env on the server).
# NEVER commit the real file. Prefer AWS Secrets Manager for DB passwords.
SECRET_KEY=<long-random-string>
JWT_SECRET_KEY=<long-random-string-at-least-32-chars>
JWT_EXPIRES_HOURS=12
DATABASE_URL=postgresql+psycopg2://taskflow:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/taskflow
CORS_ORIGINS=https://<your-amplify-domain>
FLASK_ENV=production
UPLOAD_MAX_MB=5
ALLOWED_EXTENSIONS=pdf,txt,docx
LOCAL_UPLOAD_DIR=uploads
